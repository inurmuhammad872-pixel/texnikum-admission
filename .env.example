# Generate your own Django secret key. Never commit the real value.
DEBUG=1
DJANGO_SECRET_KEY=local-development-only-replace-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Production: ALLOWED_HOSTS=your-app.up.railway.app
# Production: CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
# MEDIA_ROOT=/app/media

# Production default: closed. Enable only after approving privacy policy and directions.
ADMISSIONS_OPEN=0
